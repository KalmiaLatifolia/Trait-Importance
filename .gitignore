# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# R
.Rhistory
.RData
.Rproj.user/

# IOS
.DS_Store

# Data files and folders
raw_data/
processed_data/
*.csv
*.tif
*.tiff
*.nc
*.wav

# Outputs
outputs/
*.png
figures/*
# exception: README figure must stay tracked (keep this line after the *.png rule)
!figures/Figure1.png
models/
*.rds
*.html
*.pdf

# ------------------------------------------------------------------------------
# Data folder: tracked so that figures can be reproduced from this repo.
# These negations must stay BELOW the global *.csv / *.rds rules above,
# because .gitignore uses last-match-wins. Moving them up will silently
# untrack the data folder.
# ------------------------------------------------------------------------------
!data/**/*.csv
!data/**/*.rds

# Intermediate pipeline outputs, not needed to regenerate figures.
# Also holds xgb_variableImportance_*, which exceed GitHub's 100 MiB file limit.
data/intermediate_steps/

# other
.DS_Store

.positai
